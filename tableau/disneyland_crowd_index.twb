<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='2024.2.0 (20242.24.0807.0327)' source-platform='mac' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
<preferences />
<datasources>

<datasource caption='Daily' inline='true' name='federated.daily' version='18.1'>
  <connection class='federated'>
    <named-connections>
      <named-connection caption='Daily' name='textscan.Daily'>
        <connection class='textscan' directory='/Users/manny/Documents/disneyland-crowds/data/tableau' filename='dashboard_daily.csv' password='' server='' />
      </named-connection>
    </named-connections>
    <relation connection='textscan.Daily' name='dashboard_daily.csv' table='[dashboard_daily#csv]' type='table'>
      <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
<column datatype='date' name='Date' ordinal='0' />
<column datatype='string' name='Weekday' ordinal='1' />
<column datatype='string' name='Month' ordinal='2' />
<column datatype='real' name='Crowd Index' ordinal='3' />
<column datatype='real' name='Traffic Cars' ordinal='4' />
      </columns>
    </relation>
  </connection>
  <aliases enabled='yes' />
  <extract count='-1' enabled='true' units='records'>
    <connection access_mode='readonly' authentication='auth-none' author-locale='en_US' class='hyper' dbname='/Users/manny/Documents/disneyland-crowds/tableau/Daily.hyper' default-settings='hyper' schema='Extract' sslmode='' tablename='Extract' username='tableau'>
      <relation name='Extract' table='[Extract].[Extract]' type='table' />
    </connection>
  </extract>
</datasource>

<datasource caption='Holidays' inline='true' name='federated.holidays' version='18.1'>
  <connection class='federated'>
    <named-connections>
      <named-connection caption='Holidays' name='textscan.Holidays'>
        <connection class='textscan' directory='/Users/manny/Documents/disneyland-crowds/data/tableau' filename='dashboard_holidays.csv' password='' server='' />
      </named-connection>
    </named-connections>
    <relation connection='textscan.Holidays' name='dashboard_holidays.csv' table='[dashboard_holidays#csv]' type='table'>
      <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
<column datatype='string' name='Holiday' ordinal='0' />
<column datatype='real' name='Points' ordinal='1' />
<column datatype='string' name='Direction' ordinal='2' />
      </columns>
    </relation>
  </connection>
  <aliases enabled='yes' />
  <extract count='-1' enabled='true' units='records'>
    <connection access_mode='readonly' authentication='auth-none' author-locale='en_US' class='hyper' dbname='/Users/manny/Documents/disneyland-crowds/tableau/Holidays.hyper' default-settings='hyper' schema='Extract' sslmode='' tablename='Extract' username='tableau'>
      <relation name='Extract' table='[Extract].[Extract]' type='table' />
    </connection>
  </extract>
  <style>
    <style-rule element='mark'>
      <encoding attr='color' field='[none:Direction:nk]' type='palette'>
        <map to='#0072e3'><bucket>&quot;Busier&quot;</bucket></map>
        <map to='#c7c7cc'><bucket>&quot;Quieter&quot;</bucket></map>
        <map to='#ff9500'><bucket>&quot;Halloween&quot;</bucket></map>
      </encoding>
    </style-rule>
  </style>
</datasource>
</datasources>
<worksheets>
<worksheet name='Best Time to Visit'>
  <layout-options><title><formatted-text><run fontsize='14' bold='true'>Best time to visit: average Crowd Index by weekday and month (0 = quietest day of the year, 100 = busiest)</run></formatted-text></title></layout-options>
  <table>
    <view>
      <datasources><datasource caption='Daily' name='federated.daily' /></datasources>
      <datasource-dependencies datasource='federated.daily'>
        <column datatype='string' name='[Month]' role='dimension' type='nominal' />
        <column datatype='string' name='[Weekday]' role='dimension' type='nominal' />
        <column datatype='real' name='[Crowd Index]' role='measure' type='quantitative' />
        <column-instance column='[Crowd Index]' derivation='Avg' name='[avg:Crowd Index:qk]' pivot='key' type='quantitative' />
        <column-instance column='[Month]' derivation='None' name='[none:Month:nk]' pivot='key' type='nominal' />
        <column-instance column='[Weekday]' derivation='None' name='[none:Weekday:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
      <sort class='manual' column='[federated.daily].[none:Month:nk]' direction='ASC'><dictionary><bucket>&quot;Jan&quot;</bucket><bucket>&quot;Feb&quot;</bucket><bucket>&quot;Mar&quot;</bucket><bucket>&quot;Apr&quot;</bucket><bucket>&quot;May&quot;</bucket><bucket>&quot;Jun&quot;</bucket><bucket>&quot;Jul&quot;</bucket><bucket>&quot;Aug&quot;</bucket><bucket>&quot;Sep&quot;</bucket><bucket>&quot;Oct&quot;</bucket><bucket>&quot;Nov&quot;</bucket><bucket>&quot;Dec&quot;</bucket></dictionary></sort>
      <sort class='manual' column='[federated.daily].[none:Weekday:nk]' direction='ASC'><dictionary><bucket>&quot;Mon&quot;</bucket><bucket>&quot;Tue&quot;</bucket><bucket>&quot;Wed&quot;</bucket><bucket>&quot;Thu&quot;</bucket><bucket>&quot;Fri&quot;</bucket><bucket>&quot;Sat&quot;</bucket><bucket>&quot;Sun&quot;</bucket></dictionary></sort>
      <aggregation value='true' />
    </view>
    <style>
      <style-rule element='cell'><format attr='text-format' field='[federated.daily].[avg:Crowd Index:qk]' value='n#,##0' /></style-rule>
    </style>
    <panes>
      <pane selection-relaxation-option='selection-relaxation-allow'>
        <view><breakdown value='auto' /></view>
        <mark class='Square' />
        <encodings>
          <color column='[federated.daily].[avg:Crowd Index:qk]' />
          <text column='[federated.daily].[avg:Crowd Index:qk]' />
        </encodings>
        <style><style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule></style>
      </pane>
    </panes>
    <rows>[federated.daily].[none:Weekday:nk]</rows>
    <cols>[federated.daily].[none:Month:nk]</cols>
  </table>
</worksheet>
<worksheet name='Holidays Ranked'>
  <layout-options><title><formatted-text><run fontsize='14' bold='true'>Memorial Day packs the park. Halloween empties it. (Crowd Index vs a normal same weekday, points)</run></formatted-text></title></layout-options>
  <table>
    <view>
      <datasources><datasource caption='Holidays' name='federated.holidays' /></datasources>
      <datasource-dependencies datasource='federated.holidays'>
        <column datatype='string' name='[Holiday]' role='dimension' type='nominal' />
        <column datatype='string' name='[Direction]' role='dimension' type='nominal' />
        <column datatype='real' name='[Points]' role='measure' type='quantitative' />
        <column-instance column='[Holiday]' derivation='None' name='[none:Holiday:nk]' pivot='key' type='nominal' />
        <column-instance column='[Direction]' derivation='None' name='[none:Direction:nk]' pivot='key' type='nominal' />
        <column-instance column='[Points]' derivation='Sum' name='[sum:Points:qk]' pivot='key' type='quantitative' />
      </datasource-dependencies>
      <sort class='manual' column='[federated.holidays].[none:Holiday:nk]' direction='ASC'><dictionary><bucket>&quot;Memorial Day&quot;</bucket><bucket>&quot;New Year's Eve&quot;</bucket><bucket>&quot;Presidents' Day&quot;</bucket><bucket>&quot;MLK Day&quot;</bucket><bucket>&quot;Christmas&quot;</bucket><bucket>&quot;New Year's Day&quot;</bucket><bucket>&quot;July 4th&quot;</bucket><bucket>&quot;Labor Day&quot;</bucket><bucket>&quot;Christmas Eve&quot;</bucket><bucket>&quot;Thanksgiving&quot;</bucket><bucket>&quot;Election Day&quot;</bucket><bucket>&quot;Halloween&quot;</bucket></dictionary></sort>
      <aggregation value='true' />
    </view>
    <style>
      <style-rule element='cell'><format attr='text-format' field='[federated.holidays].[sum:Points:qk]' value='n#,##0' /></style-rule>
    </style>
    <panes>
      <pane selection-relaxation-option='selection-relaxation-allow'>
        <view><breakdown value='auto' /></view>
        <mark class='Bar' />
        <encodings>
          <color column='[federated.holidays].[none:Direction:nk]' />
          <text column='[federated.holidays].[sum:Points:qk]' />
        </encodings>
        <style><style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule></style>
      </pane>
    </panes>
    <rows>[federated.holidays].[none:Holiday:nk]</rows>
    <cols>[federated.holidays].[sum:Points:qk]</cols>
  </table>
</worksheet>
<worksheet name='Traffic Trend'>
  <layout-options><title><formatted-text><run fontsize='14' bold='true'>10 years of cars exiting I-5 at Disneyland (monthly average per day)</run></formatted-text></title></layout-options>
  <table>
    <view>
      <datasources><datasource caption='Daily' name='federated.daily' /></datasources>
      <datasource-dependencies datasource='federated.daily'>
        <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
        <column datatype='real' name='[Traffic Cars]' role='measure' type='quantitative' />
        <column-instance column='[Date]' derivation='Month-Trunc' name='[tmn:Date:qk]' pivot='key' type='quantitative' />
        <column-instance column='[Traffic Cars]' derivation='Avg' name='[avg:Traffic Cars:qk]' pivot='key' type='quantitative' />
      </datasource-dependencies>
      <aggregation value='true' />
    </view>
    <style />
    <panes>
      <pane selection-relaxation-option='selection-relaxation-allow'>
        <view><breakdown value='auto' /></view>
        <mark class='Line' />
        <style><style-rule element='mark'><format attr='mark-color' value='#0072e3' /></style-rule></style>
      </pane>
    </panes>
    <rows>[federated.daily].[avg:Traffic Cars:qk]</rows>
    <cols>[federated.daily].[tmn:Date:qk]</cols>
  </table>
</worksheet>
</worksheets>
<dashboards>
<dashboard name='Disneyland Crowd Index'>
  <style />
  <size maxheight='1000' maxwidth='1400' minheight='1000' minwidth='1400' />
  <zones>
    <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
      <zone h='100000' id='2' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
        <zone h='7000' id='3' type-v2='text' w='100000' x='0' y='0'>
          <formatted-text><run bold='true' fontsize='18'>How Crowded Is Disneyland, Really?  |  Crowd Index 2016-2026  |  Manny Sodhi</run></formatted-text>
        </zone>
        <zone h='47000' id='4' name='Best Time to Visit' w='100000' x='0' y='7000' />
        <zone h='46000' id='5' param='horz' type-v2='layout-flow' w='100000' x='0' y='54000'>
          <zone h='46000' id='6' name='Holidays Ranked' w='50000' x='0' y='54000' />
          <zone h='46000' id='7' name='Traffic Trend' w='50000' x='50000' y='54000' />
        </zone>
      </zone>
    </zone>
  </zones>
</dashboard>
</dashboards>
<windows>
  <window class='worksheet' name='Best Time to Visit'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards></window>
  <window class='worksheet' name='Holidays Ranked'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards></window>
  <window class='worksheet' name='Traffic Trend'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards></window>
  <window class='dashboard' maximized='true' name='Disneyland Crowd Index'><viewpoints><viewpoint name='Best Time to Visit' /><viewpoint name='Holidays Ranked' /><viewpoint name='Traffic Trend' /></viewpoints><active id='-1' /></window>
</windows>
</workbook>
